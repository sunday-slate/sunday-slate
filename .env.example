   # Secrets — never commit to version control.
   # Copy to .env and fill in values.

   # Optional nflverse cache database URL
   # SUNDAY_SLATE__NFLVERSE_DATABASE_URL=sqlite://./storage/nflverse-cache.db

   # Durable FanDuel upload archive, separate from the rebuildable nflverse cache.
   # Include this database in backups.
   # SUNDAY_SLATE__FANDUEL_DATABASE_URL=sqlite://./storage/fanduel-data.db

   # Optional GitHub token for server-started nflverse syncs
   # SUNDAY_SLATE__NFLVERSE_GITHUB_TOKEN=

   # Automatic nflverse cache refresh in seconds (0 = manual only)
   # SUNDAY_SLATE__NFLVERSE_SYNC_INTERVAL_SECS=0

   # Optional GitHub token for the one-shot `just nfl-sync` command
   # GITHUB_TOKEN=

   # SMTP password (required if [smtp] is configured in config.toml)
   # SUNDAY_SLATE__SMTP__PASSWORD=
