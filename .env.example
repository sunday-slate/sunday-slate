# Secrets — never commit to version control.
# Copy to .env and fill in values.

# Optional GitHub token for server-started nflverse syncs
# SUNDAY_SLATE__NFL_GITHUB_TOKEN=
# Automatic nflverse cache refresh in seconds (0 = manual only)
# SUNDAY_SLATE__NFL_SYNC_INTERVAL_SECS=
# SMTP password (required if [smtp] is configured in config.toml)
# SUNDAY_SLATE__SMTP__PASSWORD=
