use flake
dotenv_if_exists
# Shared across worktrees. rustup holds every toolchain in one home and lets
# rust-toolchain.toml pick per directory, so a per-worktree home only re-downloads
# the same stable toolchain once per worktree.
export CARGO_HOME=$HOME/.local/share/sunday-slate/cargo
export RUSTUP_HOME=$HOME/.local/share/sunday-slate/rustup

PATH_add $CARGO_HOME/bin
